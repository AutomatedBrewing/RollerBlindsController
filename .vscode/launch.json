{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug CMake test",
            "type": "cppdbg",
            "request": "launch",

            "program": "${command:cmake.launchTargetPath}",

            "args": [],

            "cwd": "${workspaceFolder}",

            "stopAtEntry": false,

            "MIMode": "gdb",

            "miDebuggerPath": "/usr/bin/gdb",

            "externalConsole": false,

            "setupCommands": [
                {
                    "description": "Enable pretty-printing",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ]
        }
    ]
}