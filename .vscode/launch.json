{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "(ctest) Debug test",
            "type": "cppdbg",
            "request": "launch",
            "program": "${cmake.testProgram}",
            "args": [],
            "cwd": "${cmake.testWorkingDirectory}",
            "environment": "${cmake.testEnvironment}",
            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/gdb"
        },
        {
            "name": "Debug NUCLEO-C011F4P6",
            "type": "cortex-debug",
            "request": "launch",
            "servertype": "jlink",
            "device": "STM32C011F4",
            "interface": "swd",
            "cwd": "${workspaceFolder}",
            "executable": "${workspaceFolder}/Software/build/rbc_C0/rbc_C0.elf",
            "gdbPath": "/usr/bin/gdb-multiarch",
            "runToEntryPoint": "main"
        }
    ]
}