{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "CMake: build current target",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build",
                "${command:cmake.buildDirectory}",
                "--target",
                "${command:cmake.buildTarget}"
            ],
            "problemMatcher": [
                "$gcc"
            ],
            "group": "build"
        }
    ]
}